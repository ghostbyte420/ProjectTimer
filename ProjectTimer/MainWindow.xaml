<Window x:Class="ProjectTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Time Clock" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/icon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock x:Name="ElapsedTimeTextBlock" Text="00:00:00"
                       FontSize="58" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock" Text="Stopped" FontSize="14"
                       HorizontalAlignment="Center" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="StartButton" Content="Start" Width="120" Height="40" FontSize="16"
                    Margin="0,0,12,0" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="120" Height="40" FontSize="16"
                    Margin="0,0,12,0" IsEnabled="False" Click="StopButton_Click"/>
            <Button x:Name="ExportButton" Content="Export to JSON" Width="140" Height="40" FontSize="14"
                    Margin="0,0,12,0" Click="ExportButton_Click"/>
            <Button x:Name="ImportButton" Content="Import from JSON" Width="140" Height="40" FontSize="14"
                    Click="ImportButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="EntriesDataGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Entries}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeDisplay}" Width="130"/>
                <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeDisplay}" Width="130"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="160"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridCheckBoxColumn Header="Complete" Binding="{Binding IsComplete}" Width="70"/>
                <DataGridCheckBoxColumn Header="Incomplete" Binding="{Binding IsIncomplete}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
