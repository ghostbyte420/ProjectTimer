<Window x:Class="ProjectTimer.StopDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop Clock" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reason for stopping:" FontWeight="Bold" Margin="0,0,0,4" Grid.Row="0"/>
        <TextBox x:Name="ReasonTextBox" Grid.Row="1" Margin="0,0,0,12"/>

        <TextBlock Text="Description of work:" FontWeight="Bold" Margin="0,0,0,4" Grid.Row="2"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Margin="0,0,0,12"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,0,0,16">
            <CheckBox x:Name="CompleteCheckBox" Content="Complete" Margin="0,0,20,0" Checked="CompleteCheckBox_Checked"/>
            <CheckBox x:Name="IncompleteCheckBox" Content="Incomplete" Checked="IncompleteCheckBox_Checked"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
